# ─── Database (Neon or Supabase — required) ────────────────────────────────
# Neon: https://neon.tech (free tier) — use the pooled connection string
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ─── Email / Resend (required for syllabus delivery) ───────────────────────
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM_EMAIL="Syvaxia <notifications@syvaxia.com>"
LEADS_NOTIFICATION_EMAIL="sales@syvaxia.com"

# ─── Sales webhook (optional — Slack / Discord / Sheets bridge) ────────────
SALES_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"
SALES_WEBHOOK_TYPE="slack"  # slack | discord | sheets

# ─── AI Advisor (optional — Gemini free tier) ──────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ─── Public site config ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://syvaxia.com"
# ⚠️ Replace with the real business WhatsApp number (international, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"

# ── Lead tracker (Excel/Sheets sync + CSV export) ──
# Free Google Apps Script Web App / Power Automate webhook that appends
# each lead as a row in the exact 15-column tracker format (optional).
EXCEL_WEBHOOK_URL=""
# Secret guarding GET /api/leads/export (the admin CSV download). Generate
# e.g. with: openssl rand -hex 24. Leave empty to keep the export closed.
ADMIN_EXPORT_KEY=""
# Shared secret between the site and the Google Apps Script sheet webhook
# (appended as ?token=... on every sync POST; the script must verify it).
EXCEL_WEBHOOK_SECRET=""
